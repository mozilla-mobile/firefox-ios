/* Name of the bookmarks folder that holds bookmarks imported from another browser. %@ is the date when the import happens, formatted for the user’s locale without the time. */
"BrowserDataTransfer.ImportedBookmarksFolder.Title.v160" = "%@ importate";

/* Button that dismisses the alert shown when Firefox could not finish importing data from another browser. */
"BrowserDataTransfer.ImportFailure.DismissButton.v160" = "Clauder";

/* Message of the alert shown when Firefox could not finish importing data from another browser. */
"BrowserDataTransfer.ImportFailure.Message.v160" = "Retenta plus tarde.";

/* Title of the alert shown when Firefox could not finish importing data from another browser. %@ is the name of the other browser, for example Safari. Data imported before the error is kept. */
"BrowserDataTransfer.ImportFailure.Title.v160" = "Impossibile importar ab %@";

/* Button that dismisses the alert shown after Firefox finishes importing data from another browser. */
"BrowserDataTransfer.ImportSuccess.GotItButton.v160" = "Comprendite";

/* Message of the alert shown after Firefox finishes importing data from another browser. %@ is the app name (e.g. Firefox). */
"BrowserDataTransfer.ImportSuccess.Message.v160" = "Tu datos importate es preste a usar in %@.";

/* Title of the alert shown after Firefox finishes importing data from another browser. %@ is the name of the other browser, for example Safari. */
"BrowserDataTransfer.ImportSuccess.Title.v160" = "Importation de %@ complete";

/* On the Data Management screen in Settings, the button that starts sending Firefox bookmarks, history, and reading lists to another browser installed on the device. */
"BrowserDataTransfer.Settings.ExportButton.v160" = "Exportar a un altere navigator";

/* On the Data Management screen in Settings, the button that starts importing bookmarks, history, and reading lists from another browser installed on the device into Firefox. */
"BrowserDataTransfer.Settings.ImportButton.v160" = "Importar ab un altere navigator";

/* On the Data Management screen in Settings, the header of the section that contains the actions to import data from, or export data to, another browser installed on the device. */
"BrowserDataTransfer.Settings.SectionTitle.v160" = "Importation e exportation de datos";

/* On the Data Management screen in Settings, the footer below the import and export buttons explaining which kinds of data can be moved between the app and another browser. %1$@ is the app name (e.g. Firefox), used in both places. */
"BrowserDataTransfer.Settings.SupportedDataFooter.v160" = "Apporta marcapaginas, chronologia, e listas de lectura in %1$@, o invia tu datos de %1$@ a un altere navigator.";

