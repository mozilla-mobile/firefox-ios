/* On the Privacy Dashboard popup, the accessibility label read out for one of the tracker category rows. The first placeholder (%1$@) is the category's name, such as Fingerprinters. The second placeholder (%2$@) is how many trackers of that category we've blocked this week. */
"PrivacyDashboard.CategoryAccessibilityLabel.v156" = "%1$@, s’han blocat: %2$@";

/* On the Privacy Dashboard popup, the title text for the bar & label showing how many cross-site tracking cookies we've blocked. */
"PrivacyDashboard.CrossSiteTrackers.v155" = "Galetes de seguiment entre llocs";

/* On the Privacy Dashboard popup, the title text for the bar & label showing how many fingerprinter's we've blocked. */
"PrivacyDashboard.Fingerprinters.v155" = "Generadors d’empremtes digitals";

/* On the Privacy Dashboard popup, the text for the header when we have blocked some trackers this week. This is going to have, above it, in bold letters, the number of trackers blocked this week. */
"PrivacyDashboard.HeaderLabel.v155" = "Elements de seguiment blocats aquesta setmana";

/* On the Privacy Dashboard popup, the accessibility label read out for the weekly count. The count and the header below it are two separate labels on screen, but are read out as this one sentence. The placeholder (%@) is how many trackers we've blocked this week. */
"PrivacyDashboard.HeaderLabelAccessibilityLabel.v156" = "Elements de seguiment blocats aquesta setmana: %@";

/* On the Privacy Dashboard popup, the text for the header of the popup, in the case where we have not yet blocked any trackers yet. The placeholder %@ will be the app name, Firefox. */
"PrivacyDashboard.HeaderLabelForNoTrackersBlocked.v155" = "El %@ bloca els elements de seguiment mentre navegueu. Els veureu aquí.";

/* On the Privacy Dashboard popup, the title text for the bar & label showing how many social media trackers we've blocked. */
"PrivacyDashboard.SocialTrackers.v155" = "Elements de seguiment de xarxes socials";

/* On the Privacy Dashboard popup, the text for the footer of the page. The first placeholder (%1$@) is the total number of trackers we've blocked, in a localized format (provided by Swift's built in number localization). The second placeholder (%2$@) will be a date in DD/MM/YY format, and will denote the date we've started blocking trackers for the user. */
"PrivacyDashboard.TotalTrackersBlockedSince.v155" = "%1$@ des del %2$@ 🎉";

/* On the Privacy Dashboard popup, the title text for the bar & label showing how much tracking content we've blocked. */
"PrivacyDashboard.TrackingContent.v155" = "Contingut que fa seguiment";

