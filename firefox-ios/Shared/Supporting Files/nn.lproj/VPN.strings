/* Button on the popup shown when the VPN stops working while the user is browsing. Tapping it closes all of the user's open tabs. */
"VPN.ErrorBrowsingPopup.CloseAllTabs.v160" = "Lat att alle faner";

/* Confirmation shown after the user closes a single tab from the popup that appears when the VPN stops working while browsing. */
"VPN.ErrorBrowsingPopup.ClosedOneTab.v160" = "Lét att 1 fane";

/* Confirmation shown after the user closes more than one tab from the popup that appears when the VPN stops working while browsing. %1$@ is the number of tabs that were closed (for example, 3). */
"VPN.ErrorBrowsingPopup.ClosedXTabs.v160" = "Lét att %1$@ faner";

/* Button on the popup shown when the VPN stops working while the user is browsing. Tapping it closes only the tab the user is currently viewing. */
"VPN.ErrorBrowsingPopup.CloseThisTab.v160" = "Lat att denne fana";

/* Button on the popup shown when the VPN stops working while the user is browsing. Tapping it closes the popup so the user can keep browsing without the VPN. */
"VPN.ErrorBrowsingPopup.Continue.v160" = "Hald fram utan VPN";

/* Title of a popup shown when the VPN stops working while the user is browsing with it on. Asks if the user wants to keep browsing without the VPN. */
"VPN.ErrorBrowsingPopup.Title.v160" = "Halde fram utan VPN?";

/* Body text of the popup shown when the app fails to connect to the VPN. “Try again” means try connecting to the VPN again. */
"VPN.ErrorConnectingPopup.Body.v160" = "Prøv igjen om nokre minutt.";

/* Button on the popup shown when the app fails to connect to the VPN. Tapping it closes the popup. */
"VPN.ErrorConnectingPopup.CloseButtonText.v160" = "Lat att";

/* Button on the popup shown when the app fails to connect to the VPN. Tapping it tries to connect to the VPN again. */
"VPN.ErrorConnectingPopup.RetryButtonText.v160" = "Prøv igjen";

/* Title of a popup shown when the app fails to connect to the VPN. */
"VPN.ErrorConnectingPopup.Title.v160" = "Klarte ikkje å kople til VPN";

/* Button on the popup shown when the user runs out of free monthly VPN data. Tapping it closes all of the user's open tabs. */
"VPN.ReachedDataLimitPopup.CloseAllTabs.v160" = "Lat att alle faner";

/* Confirmation shown after the user closes a single tab from the popup that appears when they run out of free monthly VPN data. */
"VPN.ReachedDataLimitPopup.ClosedOneTab.v160" = "Lét att 1 fane";

/* Confirmation shown after the user closes more than one tab from the popup that appears when they run out of free monthly VPN data. %1$@ is the number of tabs that were closed (for example, 3). */
"VPN.ReachedDataLimitPopup.ClosedXTabs.v160" = "Lét att %1$@ faner";

/* Button on the popup shown when the user runs out of free monthly VPN data. Tapping it closes only the tab the user is currently viewing. */
"VPN.ReachedDataLimitPopup.CloseThisTab.v160" = "Lat att denne fana";

